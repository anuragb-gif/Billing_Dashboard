# Copy this file to ".env" and fill in your real values.
# .env is never committed or shared - it stays on your PC only.

# ---- Source SQL Server (the one you run these queries against today) ----
SQL_SERVER=your-server-name-or-ip
SQL_DATABASE=your-main-database-name
SQL_USER=your-sql-login
SQL_PASSWORD=your-sql-password
SQL_PORT=1433
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERT=true

# ---- Local reporting store (created automatically, no setup needed) ----
LOCAL_DB_PATH=./data/dashboard.db

# ---- API server ----
PORT=4000

# ---- Dashboard login (one shared password for the whole team) ----
DASHBOARD_PASSWORD=pick-a-team-password
# Signs the login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---- Refresh schedule (cron syntax) - default: every night at 2:30 AM ----
REFRESH_CRON=30 2 * * *
